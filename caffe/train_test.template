  }
}
layer {
  name: "relu1"
  type: "ReLU"
  bottom: "ip1_note"
  top: "ip1_note"
}
layer {
  name: "relu2"
  type: "ReLU"
  bottom: "ip1_time"
  top: "ip1_time"
}
layer {
  name: "relu3"
  type: "ReLU"
  bottom: "ip1_duration"
  top: "ip1_duration"
}
layer {
  name: "relu4"
  type: "ReLU"
  bottom: "ip1_velocity"
