layer {
  name: "Data1"
  type: "Data"
  top: "Data1"
  include {
    phase: TRAIN
  }
  transform_param {
    scale: 0.00392156862745
  }
  data_param {
    source: "music/lmdb/train/images"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "Data1"
  type: "Data"
  top: "Data1"
  include {
    phase: TEST
  }
  transform_param {
    scale: 0.00392156862745
  }
  data_param {
    source: "music/lmdb/test/images"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "Convolution1"
  type: "Convolution"
  bottom: "Data1"
  top: "Convolution1"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 16
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
    kernel_h: 2
    kernel_w: 2
    stride_h: 1
    stride_w: 1
  }
}
layer {
  name: "ReLU1"
  type: "ReLU"
  bottom: "Convolution1"
  top: "Convolution1"
}
layer {
  name: "Convolution2"
  type: "Convolution"
  bottom: "Convolution1"
  top: "Convolution2"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 32
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
    kernel_h: 4
    kernel_w: 4
    stride_h: 2
    stride_w: 2
  }
}
layer {
  name: "ReLU2"
  type: "ReLU"
  bottom: "Convolution2"
  top: "Convolution2"
}
layer {
  name: "Convolution3"
  type: "Convolution"
  bottom: "Convolution2"
  top: "Convolution3"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 32
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
    kernel_h: 8
    kernel_w: 8
    stride_h: 4
    stride_w: 4
  }
}
layer {
  name: "ReLU2"
  type: "ReLU"
  bottom: "Convolution3"
  top: "Convolution3"
}
layer {
  name: "Pooling1"
  type: "Pooling"
  bottom: "Convolution3"
  top: "Pooling1"
  pooling_param {
    pool: MAX
    kernel_h: 4
    kernel_w: 4
    stride_h: 1
    stride_w: 1
  }
}
layer {
  name: "InnerProduct1"
  type: "InnerProduct"
  bottom: "Pooling1"
  top: "InnerProduct1"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 200
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
  }
}
layer {
  name: "ReLU4"
  type: "ReLU"
  bottom: "InnerProduct1"
  top: "InnerProduct1"
}
layer {
  name: "Dropout1"
  type: "Dropout"
  bottom: "InnerProduct1"
  top: "Dropout1"
  dropout_param {
    dropout_ratio: 0.5
  }
}
layer {
  name: "InnerProduct3"
  type: "InnerProduct"
  bottom: "Dropout1"
  top: "InnerProduct3"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 100
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
  }
}
layer {
  name: "ReLU6"
  type: "ReLU"
  bottom: "InnerProduct3"
  top: "InnerProduct3"
}
layer {
  name: "InnerProduct4"
  type: "InnerProduct"
  bottom: "InnerProduct3"
  top: "InnerProduct4"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 128
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
  }
}
layer {
  name: "Data2"
  type: "Data"
  top: "Data2"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/notes"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "Data2"
  type: "Data"
  top: "Data2"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/notes"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "SoftmaxWithLoss1"
  type: "SoftmaxWithLoss"
  bottom: "InnerProduct4"
  bottom: "Data2"
  top: "SoftmaxWithLoss1"
}
layer {
  name: "InnerProduct5"
  type: "InnerProduct"
  bottom: "Dropout1"
  top: "InnerProduct5"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 100
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
  }
}
layer {
  name: "ReLU7"
  type: "ReLU"
  bottom: "InnerProduct5"
  top: "InnerProduct5"
}
layer {
  name: "InnerProduct6"
  type: "InnerProduct"
  bottom: "InnerProduct5"
  top: "InnerProduct6"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 128
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.125
    }
  }
}
layer {
  name: "Data3"
  type: "Data"
  top: "Data3"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/times"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "Data3"
  type: "Data"
  top: "Data3"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/times"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "SoftmaxWithLoss2"
  type: "SoftmaxWithLoss"
  bottom: "InnerProduct6"
  bottom: "Data3"
  top: "SoftmaxWithLoss2"
}
layer {
  name: "Accuracy1"
  type: "Accuracy"
  bottom: "InnerProduct4"
  bottom: "Data2"
  top: "Accuracy1"
  include {
    phase: TEST
  }
  accuracy_param {
    top_k: 4
  }
}
layer {
  name: "Accuracy2"
  type: "Accuracy"
  bottom: "InnerProduct6"
  bottom: "Data3"
  top: "Accuracy2"
  include {
    phase: TEST
  }
  accuracy_param {
    top_k: 4
  }
}
