
train_net: 'music/net/3/train_test.prototxt'
test_net: 'music/net/3/train_test.prototxt'
test_iter: 270
test_interval: 1000
# The base learning rate, momentum and the weight decay of the network.
base_lr: 0.0005
momentum: 0.9
weight_decay: 0.0005
# The learning rate policy
lr_policy: "inv"
gamma: 0.0001
power: 0.75
# Display every 100 iterations
display: 100
# The maximum number of iterations
max_iter: 100000
# snapshot intermediate results
snapshot: 1000
snapshot_prefix: "music/net/3/snapshots/2016Apr21"
#solver mode: CPU or GPU
solver_mode: CPU
