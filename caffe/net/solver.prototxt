
train_net: '/home/joshua/node/caffe/music/net/train.prototxt'
test_net: '/home/joshua/node/caffe/music/net/test.prototxt'
test_iter: 20
test_interval: 1000
# The base learning rate, momentum and the weight decay of the network.
base_lr: 0.0005
momentum: 0.9
weight_decay: 0.0005
# The learning rate policy
lr_policy: "inv"
gamma: 0.0001
power: 0.75
# Display every 100 iterations
display: 100
# The maximum number of iterations
max_iter: 100000
# snapshot intermediate results
snapshot: 2500
snapshot_prefix: "/home/joshua/node/caffe/music/net/snapshots/2016Apr08-16:35-0"
#solver mode: CPU or GPU
solver_mode: CPU
