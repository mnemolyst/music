layer {
  name: "Convolution1"
  type: "Convolution"
  bottom: "Images"
  top: "Convolution1"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 16
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.2
    }
    kernel_h: 9
    kernel_w: 17
    pad_h: 4
    pad_w: 8
    stride_h: 1
    stride_w: 1
  }
}
layer {
  type: "ReLU"
  bottom: "Convolution1"
  top: "Convolution1"
}
layer {
  name: "Convolution2"
  type: "Convolution"
  bottom: "Convolution1"
  top: "Convolution2"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 64
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
      value: 0.2
    }
    kernel_h: 5
    kernel_w: 9
    pad_h: 2
    pad_w: 4
    stride_h: 1
    stride_w: 2
  }
}
layer {
  type: "ReLU"
  bottom: "Convolution2"
  top: "Convolution2"
}
layer {
  name: "Convolution3"
  type: "Convolution"
