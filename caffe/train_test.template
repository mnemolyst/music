name: "Music"
layer {
  name: "images"
  type: "Data"
  top: "images"
  include {
    phase: TRAIN
  }
  transform_param {
    scale: 0.00390625
  }
  data_param {
    source: "music/lmdb/train/images"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "notes"
  type: "Data"
  top: "notes"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/notes"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "times"
  type: "Data"
  top: "times"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/times"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "durations"
  type: "Data"
  top: "durations"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/durations"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "velocities"
  type: "Data"
  top: "velocities"
  include {
    phase: TRAIN
  }
  data_param {
    source: "music/lmdb/train/velocities"
    batch_size: 10
    backend: LMDB
  }
}
layer {
  name: "images"
  type: "Data"
  top: "images"
  include {
    phase: TEST
  }
  transform_param {
    scale: 0.00390625
  }
  data_param {
    source: "music/lmdb/test/images"
    batch_size: 25
    backend: LMDB
  }
}
layer {
  name: "notes"
  type: "Data"
  top: "notes"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/notes"
    batch_size: 25
    backend: LMDB
  }
}
layer {
  name: "times"
  type: "Data"
  top: "times"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/times"
    batch_size: 25
    backend: LMDB
  }
}
layer {
  name: "durations"
  type: "Data"
  top: "durations"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/durations"
    batch_size: 25
    backend: LMDB
  }
}
layer {
  name: "velocities"
  type: "Data"
  top: "velocities"
  include {
    phase: TEST
  }
  data_param {
    source: "music/lmdb/test/velocities"
    batch_size: 25
    backend: LMDB
  }
}
layer {
  name: "conv1"
  type: "Convolution"
  bottom: "images"
  top: "conv1"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: %{
        type = int
        min = 5
        max = 100
        step = 3
    }%
    kernel_h: 3
    kernel_w: 6
    stride_h: 1
    stride_w: 3
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
    }
  }
}
layer {
  name: "pool1"
  type: "Pooling"
  bottom: "conv1"
  top: "pool1"
  pooling_param {
    pool: MAX
    kernel_h: 3
    kernel_w: 6
    stride_h: 1
    stride_w: 3
  }
}
layer {
  name: "conv2"
  type: "Convolution"
  bottom: "pool1"
  top: "conv2"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  convolution_param {
    num_output: 50
    kernel_size: 10
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
    }
  }
}
layer {
  name: "pool2"
  type: "Pooling"
  bottom: "conv2"
  top: "pool2"
  pooling_param {
    pool: MAX
    kernel_size: 2
    stride: 2
  }
}
layer {
  name: "ip1_note"
  type: "InnerProduct"
  bottom: "pool2"
  top: "ip1_note"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 500
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
    }
  }
}
layer {
  name: "ip1_time"
  type: "InnerProduct"
  bottom: "pool2"
  top: "ip1_time"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 300
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
    }
  }
}
layer {
  name: "ip1_duration"
  type: "InnerProduct"
  bottom: "pool2"
  top: "ip1_duration"
  param {
    lr_mult: 1
  }
  param {
    lr_mult: 2
  }
  inner_product_param {
    num_output: 300
    weight_filler {
      type: "xavier"
    }
    bias_filler {
      type: "constant"
    }
  }
}
layer {
  name: "ip1_velocity"
  type: "InnerProduct"
  bottom: "pool2"
  top: "ip1_velocity"
  param {
