
train_net: 'music/net/7/train_test.prototxt'
test_net: 'music/net/7/train_test.prototxt'
test_iter: 4
test_interval: 1000
# The base learning rate, momentum and the weight decay of the network.
base_lr: 0.002
momentum: 0.9
weight_decay: 0.0005
# The learning rate policy
lr_policy: "inv"
gamma: 0.0001
power: 0.75
# Display progress
display: 100
max_iter: 100000
snapshot: 5000
snapshot_prefix: "music/net/7/snapshots/"
solver_mode: GPU
